{
  "name": "Rust Hello World",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "serayuzgur.crates"
      ]
    }
  },
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash",
    "rust-analyzer.cargo.loadOutDirsFromCheck": true
  },
  "postCreateCommand": "cargo check",
  "remoteUser": "vscode"
}
